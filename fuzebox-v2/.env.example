# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection URL
# Local dev: postgresql://fuzebox:fuzebox_secret@localhost:5432/fuzebox_db
# Docker:    postgresql://fuzebox:fuzebox_secret@postgres:5432/fuzebox_db
DATABASE_URL=postgresql://fuzebox:fuzebox_secret@localhost:5432/fuzebox_db

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Get from console.anthropic.com
CLAUDE_API_KEY=sk-ant-api03-...

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

# Token lifetime in hours (default 24)
JWT_EXPIRE_HOURS=24

# First-run bootstrap admin account (only used if no users exist in DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── ECL (Workforce) ────────────────────────────────────────────────────────────
ECL_API_KEY=key_demo11
ECL_API_URL=http://localhost:5000

# ── Next.js frontend (local dev: frontend/.env.local) ─────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Docker Compose builds the frontend image with this URL for the browser.
