# FuzeBox AEOS — Economic Cognition Layer
# Copy to .env and fill in.

# Server
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database — Postgres (required). The default below is the Postgres container from
# fuzebox-v2's docker-compose (port 5433). Create the database once, then push the schema:
#   docker exec fuzebox-postgres createdb -U fuzebox fuzebox-aeos
#   npm run db:push
DATABASE_URL=postgresql://fuzebox:fuzebox_secret@127.0.0.1:5433/fuzebox-aeos

# JWT signing secret (required — the server will not start without it)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# First-run bootstrap admin account (created on startup if the username does not exist).
# Defaults to admin / changeme in development. In production it is only created when
# ADMIN_PASSWORD is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# The default workspace is filled with synthetic demo data on first run (development only).
# Uncomment to start with an empty workspace instead.
# SEED_DEMO_DATA=false

# HMAC secret for canonical event chain (Observation Plane, Family 6)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, scope per-tenant via KMS
HMAC_SECRET=replace-me-with-32-bytes-hex

# Optional: default tenant for dev requests when X-Tenant-Id header missing
DEFAULT_TENANT_ID=ten_demo
WORKFORCE_RESUME_URL=http://fuzebox-webhook-v2:8000/api/workforce/resume

# Optional: fires a POST to this URL after every successful agent deployment (fire-and-forget)
# Per-deployment URL set from the UI takes precedence; this env var is the global fallback
DEPLOYMENT_WEBHOOK_URL=
# Optional: HMAC-SHA256 secret — adds X-Webhook-Signature header to deployment callbacks
DEPLOYMENT_WEBHOOK_SECRET=
ECL_API_KEY=key_demo11
ECL_API_URL=http://localhost:5000
WEBHOOK_URL=http://localhost:8000
ECL_SECRET_KEY=replace-with-shared-secret